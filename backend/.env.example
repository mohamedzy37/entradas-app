# Copia este fichero a .env y ajusta los valores.
ENVIRONMENT=development
PORT=3000
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/entradas_py
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ORDER_RESERVATION_MINUTES=15
DEFAULT_CURRENCY=EUR

# Dos secretos DISTINTOS (access y refresh). Genera cada uno con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CAMBIAR_ESTE_SECRETO_POR_UNO_ALEATORIO_DE_64_CARACTERES
JWT_REFRESH_SECRET=CAMBIAR_ESTE_OTRO_SECRETO_POR_UNO_ALEATORIO_DE_64_CARACTERES
JWT_ALGORITHM=HS256
JWT_ISSUER=entradas-api
JWT_AUDIENCE=entradas-web

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Cookie del refresh token (HttpOnly + SameSite=Strict siempre).
# Sin definir = automatico: Secure solo con ENVIRONMENT=production (HTTPS).
# COOKIE_SECURE=true

AUTH_RATE_LIMIT_PER_MINUTE=20

# Login con Google (opcional; vacio = desactivado). En desarrollo, autoriza en
# Google Cloud la URI del proxy de Vite:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
