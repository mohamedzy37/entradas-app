# Plantilla procesada con envsubst al arrancar (imagen oficial de Nginx).
# Variables: ${HTTPS_PORT}. Las variables de Nginx ($host...) no se tocan.

# Limitacion de peticiones a los endpoints de autenticacion (fuerza bruta).
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_status 429;

upstream api {
    server backend:3000;
    keepalive 16;
}

# --- HTTP: solo redirige a HTTPS ---
server {
    listen 8080;
    server_name _;
    server_tokens off;

    location / {
        return 301 https://$host:${HTTPS_PORT}$request_uri;
    }
}

# --- HTTPS ---
server {
    listen 8443 ssl;
    http2 on;
    server_name _;
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    # Configuracion "intermediate" de Mozilla: TLS 1.2 y 1.3, cifrados AEAD.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 1m;
    root /usr/share/nginx/html;

    # Lista publica de proveedores de login: se consulta en cada visita al
    # login/registro, asi que no cuenta para el limite de autenticacion.
    location = /api/auth/providers {
        include /etc/nginx/snippets/proxy.conf;
    }

    # API: autenticacion con limite estricto de peticiones (incluye Google).
    location /api/auth/ {
        limit_req zone=auth burst=10 nodelay;
        include /etc/nginx/snippets/proxy.conf;
    }

    # Resto de la API.
    location /api/ {
        include /etc/nginx/snippets/proxy.conf;
    }

    location = /health {
        include /etc/nginx/snippets/proxy.conf;
    }

    # Estaticos con hash en el nombre: cache larga.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA: cualquier ruta del frontend sirve index.html (React Router).
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }

    # Nunca servir ficheros ocultos (.git, .env...) aunque se colasen.
    location ~ /\. {
        deny all;
        return 404;
    }
}
