# Configuracion del despliegue con Docker. NO subas el .env real al repo.
# Lo mas comodo es generarlo con:  scripts\generar-env.ps1

# Secretos (valores aleatorios largos; los JWT deben ser distintos entre si).
POSTGRES_PASSWORD=CAMBIAR
JWT_SECRET=CAMBIAR_POR_64_CARACTERES_HEX
JWT_REFRESH_SECRET=CAMBIAR_POR_OTROS_64_CARACTERES_HEX

# Origen publico del frontend (sin barra final). Si cambias HTTPS_PORT,
# incluye el puerto: https://localhost:8443
PUBLIC_ORIGIN=https://localhost
HTTP_PORT=80
HTTPS_PORT=443
TLS_CN=localhost

# Carga usuarios y eventos de demostracion (true para la practica).
# En un despliegue real: false.
SEED_DEMO_DATA=true
